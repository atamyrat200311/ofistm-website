# Contact form delivery. Configure at least one channel in Vercel → Project → Settings → Environment Variables.

# Option A: Telegram bot (recommended). Create a bot with @BotFather, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option B: Email via Resend (https://resend.com). FROM must be on a verified domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=ofis.tm <noreply@ofistm.com>
